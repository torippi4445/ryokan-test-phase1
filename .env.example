# このファイルを .env にコピーして値を入れてください。
# .env は .gitignore で除外されています（絶対にコミットしないこと）。

# --- 必須 ---
# Anthropic API キー https://console.anthropic.com/ で発行
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# --- メール実送信を使う場合のみ（npm run e2e:send）---
# 送信元の Gmail アドレス
SMTP_USER=you@gmail.com
# Google の「アプリパスワード」16桁（2段階認証の有効化が必要）
# https://myaccount.google.com/apppasswords
SMTP_PASS=xxxxxxxxxxxxxxxx
# 動作確認用に、送信先を自分のアドレスへ上書きする（任意）
TEST_GUEST_TO=you@example.com
