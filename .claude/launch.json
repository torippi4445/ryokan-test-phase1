{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "n8n",
      "runtimeExecutable": "docker",
      "runtimeArgs": [
        "run",
        "-d",
        "--name",
        "n8n",
        "-p",
        "5678:5678",
        "-v",
        "n8n_data:/home/node/.n8n",
        "docker.n8n.io/n8nio/n8n"
      ],
      "port": 5678
    }
  ]
}
